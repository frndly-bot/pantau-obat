# Salin file ini menjadi .env di folder yang sama, lalu isi nilainya:
#   cp .env.example .env
#
# .env TIDAK masuk git (lihat .gitignore root). Nilainya dipakai oleh Bruno
# lewat interpolasi `{{process.env.NAMA}}` di environments/local.yml, jadi
# password/secret tidak pernah tersimpan di file yang ikut ter-commit.

# Password akun admin uji. Harus sama dengan akun yang dibuat lewat:
#   go run ./cmd/admin-bootstrap --email <ADMIN_EMAIL> --password <ADMIN_PASSWORD>
ADMIN_PASSWORD=ganti-password-admin-uji

# Secret HMAC untuk webhook status kirim email (provider -> backend).
# Harus sama dengan WEBHOOK_EMAIL_SECRET di backend/.env saat server dijalankan.
EMAIL_WEBHOOK_SECRET=ganti-secret-webhook-email

# Secret token webhook Telegram (header X-Telegram-Bot-Api-Secret-Token).
# Harus sama dengan TELEGRAM_WEBHOOK_SECRET di backend/.env saat server dijalankan.
TELEGRAM_WEBHOOK_SECRET=ganti-secret-webhook-telegram
