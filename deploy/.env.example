# =============================================================================
# Pantau Obat — konfigurasi deploy
# =============================================================================
# Salin menjadi .env lalu isi nilainya:
#   cp .env.example .env
# .env TIDAK boleh masuk git (berisi secret). .gitignore sudah menutupnya.
#
# Semua variabel di bawah dipakai oleh deploy/docker-compose.yml.

# -----------------------------------------------------------------------------
# WAJIB — tanpa ini compose menolak naik
# -----------------------------------------------------------------------------

# Database. User ini BUKAN superuser.
POSTGRES_DB=pantau_obat
POSTGRES_USER=pantau_obat

# WAJIB diganti. Buat yang kuat:  openssl rand -base64 32
POSTGRES_PASSWORD=ganti-password-ini

# Secret JWT, minimal 32 byte. Buat acak:  openssl rand -base64 48
# Kalau diganti, seluruh access token yang sudah beredar hangus (user login
# ulang) — itu perilaku yang benar saat secret dirotasi.
JWT_SECRET=ganti_dengan_string_acak_minimal_32_byte

# URL publik aplikasi. Dipakai menyusun tautan undangan caregiver.
# Tautan yang disusun dari header Host bisa diarahkan penyerang ke domainnya
# sendiri, sehingga nilai ini HARUS eksplisit, bukan ditebak dari request.
APP_PUBLIC_URL=https://pantauobat.example.com

# -----------------------------------------------------------------------------
# Port & jangkauan
# -----------------------------------------------------------------------------

# Port Postgres di HOST. Di produksi WAJIB diubah di docker-compose.yml
# menjadi "127.0.0.1:${POSTGRES_PORT}:5432" supaya DB tidak terbuka ke internet.
POSTGRES_PORT=5432

# Port API di HOST. Bawaan hanya mendengarkan localhost (di belakang reverse
# proxy). Kosongkan "127.0.0.1:" hanya kalau container dipublikasikan langsung.
APP_PORT_HOST=127.0.0.1:8080

# -----------------------------------------------------------------------------
# Opsional — aplikasi tetap jalan tanpa ini
# -----------------------------------------------------------------------------

# production | development. Di production, admin-bootstrap menolak jalan
# tanpa langkah eksplisit, dan cookie refresh memakai Secure.
APP_ENV=production

# Batas koneksi pool per instance api. VPS kecil: jangan dinaikkan tanpa
# alasan — tiap koneksi memakan memori di sisi Postgres.
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Umur sesi. Access token 24 jam (1440 menit), refresh 30 hari.
JWT_TTL_MINUTES=1440
REFRESH_TTL_DAYS=30

# info | warn | error. info memuat satu baris JSON per request.
LOG_LEVEL=info

# Batas laju permintaan per IP per menit (endpoint publik). 0 = bawaan 60.
RATE_LIMIT_IP_PER_MIN=60

# -----------------------------------------------------------------------------
# Webhook masuk (opsional)
# -----------------------------------------------------------------------------
# Secret verifikasi webhook dari penyedia eksternal. Kosong = webhook 500
# "belum diaktifkan" (perilaku yang benar, bukan bug).
WEBHOOK_EMAIL_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Kanal notifikasi (opsional, v0.2)
# -----------------------------------------------------------------------------
# Tanpa kredensial di bawah, pengingat TIDAK dikirim — hanya dicatat ke log
# dengan alasan "tidak ada kanal notifikasi yang dikonfigurasi".

# Web Push. Buat pasangan kunci:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Email (SMTP). SMTP_FROM contoh: "Pantau Obat <no-reply@example.com>"
#
# Sejak alur LUPA SANDI ada, email bukan lagi kanal opsional: tanpa SMTP,
# pengguna yang lupa sandinya tidak punya jalan masuk kembali. Bila
# dikosongkan, endpoint /auth/forgot-password menolak dengan pesan yang
# menyebut sebabnya — bukan diam-diam mengaku sudah mengirim.
#
# Untuk pengembangan, `docker compose up -d mailhog` menyediakan SMTP palsu
# yang menampung semua surat di http://localhost:8025:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_FROM="Pantau Obat <no-reply@pantau-obat.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Object storage (pgsty/silo) untuk foto resep.
#
# Wajib diisi: service `silo` di docker-compose memakai variabel ini untuk
# kredensialnya, dan compose MENOLAK jalan bila kosong. Isi dengan nilai
# acak, misalnya:  openssl rand -hex 16
#
# Backend membacanya lewat STORAGE_* (lihat backend/.env.example). Bila
# dikosongkan seluruhnya, aplikasi tetap jalan dan fitur foto resep
# menjawab "belum tersedia".
SILO_ROOT_USER=
SILO_ROOT_PASSWORD=
SILO_API_PORT=9000
SILO_CONSOLE_PORT=9001

# Bot Telegram.
TELEGRAM_BOT_TOKEN=

# ============================================================================
# Web (Caddy: berkas statis frontend + reverse proxy /api)
# ============================================================================
#
# SITE_ADDRESS menentukan alamat yang dilayani Caddy:
#   ":80"                 → pengujian lokal, tanpa TLS
#   "obat.contoh.com"     → produksi; Caddy menerbitkan sertifikat TLS otomatis
#   "obat.contoh.com:443" → sama, dengan port eksplisit
SITE_ADDRESS=:80

# Port di host. Di produksi, hanya 80 dan 443 yang perlu terbuka.
WEB_PORT_HOST=80
WEB_PORT_HOST_TLS=443

# ============================================================================
# Retention (pembersihan data kedaluwarsa)
# ============================================================================
# Jam jalan dalam UTC. Bawaan 3 (= 10:00 WIB), sengaja di luar jam sunyi
# pengguna (22:00-06:00 lokal). Container menjalankan pembersihan sekali
# sehari pada jam ini, lalu menunggu lagi.
RETENTION_HOUR=3
