# Salin file ini menjadi compose.env lalu isi nilainya.
#   cp compose.env.example compose.env
# compose.env TIDAK boleh masuk git (berisi secret).

# Nama database dan user aplikasi. User ini BUKAN superuser.
POSTGRES_DB=pantau_obat
POSTGRES_USER=pantau_obat

# WAJIB diganti. Jangan pakai nilai contoh ini.
# Buat yang kuat, mis.:  openssl rand -base64 32
POSTGRES_PASSWORD=ganti-password-ini

# Port di host.
# Untuk produksi, pilih 127.0.0.1:${POSTGRES_PORT} di docker-compose.yml
# supaya database tidak terbuka ke internet.
POSTGRES_PORT=5432
