# =============================================================================
# Pantau Obat — contoh konfigurasi backend.
# Salin: cp .env.example .env  (file .env TIDAK masuk git)
# =============================================================================

APP_ENV=development
APP_PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_URL=postgres://pantau_obat:ubah_saya@localhost:5432/pantau_obat?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# -----------------------------------------------------------------------------
# Autentikasi
# Hasilkan: openssl rand -base64 48   (minimal 32 byte)
# -----------------------------------------------------------------------------
JWT_SECRET=ganti_dengan_string_acak_minimal_32_byte
JWT_TTL_MINUTES=1440
REFRESH_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Web push (VAPID) — wajib bila kanal push aktif
# Hasilkan pasangan kunci: lihat docs/design-v2/notification-v2.md
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# -----------------------------------------------------------------------------
# Email — wajib bila kanal email aktif, dan untuk alur LUPA SANDI
# -----------------------------------------------------------------------------
# Sejak alur lupa sandi ada, email bukan lagi kanal opsional: tanpa SMTP,
# pengguna yang lupa sandinya tidak punya jalan masuk kembali. Bila
# dikosongkan, /auth/forgot-password menolak dengan pesan yang menyebut
# sebabnya, bukan diam-diam mengaku sudah mengirim.
#
# Untuk pengembangan, MailHog dari deploy/docker-compose.yml:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_FROM="Pantau Obat <no-reply@pantau-obat.local>"
# Surat yang "terkirim" bisa dibaca di http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Object storage untuk foto resep (pgsty/silo)
# -----------------------------------------------------------------------------
# Endpoint tanpa skema: "127.0.0.1:9000". Kredensialnya sama dengan
# SILO_ROOT_USER / SILO_ROOT_PASSWORD di deploy/.env.
#
# Bila dikosongkan, aplikasi tetap jalan dan fitur foto resep menjawab
# "belum tersedia" — mencatat obat tidak bergantung pada penyimpanan berkas.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=pantau-obat
STORAGE_USE_SSL=false

# -----------------------------------------------------------------------------
# Telegram (v0.2) — wajib bila kanal telegram aktif
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Webhook — HMAC untuk status kirim penyedia email
# -----------------------------------------------------------------------------
WEBHOOK_EMAIL_SECRET=

# -----------------------------------------------------------------------------
# Operasional
# -----------------------------------------------------------------------------
RATE_LIMIT_IP_PER_MIN=60
LOG_LEVEL=info
MIGRATE_ON_START=true
